{
  "name": "higiri",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "dev:sample": "tauri dev -- -- --sample-data",
    "dev:web": "vite",
    "build": "node scripts/package.mjs",
    "icons": "node scripts/icons.mjs",
    "build:web": "npm run typecheck && vite build",
    "tauri": "tauri",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "test:perf": "cargo test --release --manifest-path src-tauri/Cargo.toml perf -- --ignored --nocapture",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "fmt:rust": "cargo fmt --manifest-path src-tauri/Cargo.toml --check",
    "lint:rust": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings",
    "check": "npm run typecheck && npm run fmt:rust && npm test && npm run test:rust && npm run lint:rust"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans-jp": "^5.3.1",
    "@lezer/highlight": "^1.2.5",
    "@tanstack/react-query": "^5.108.0",
    "@tauri-apps/api": "^2.12.5",
    "@tauri-apps/plugin-clipboard-manager": "^2.5.0",
    "@tauri-apps/plugin-log": "^2.10.2",
    "@tauri-apps/plugin-opener": "^2.7.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.6",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
