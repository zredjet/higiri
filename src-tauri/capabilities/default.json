{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window: the app's own commands, opening http(s) links in the default browser, writing text to the clipboard, and writing log lines. No core window/event/path APIs: the screens do not use them.",
  "windows": [
    "main"
  ],
  "permissions": [
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://*"
        },
        {
          "url": "http://*"
        }
      ]
    },
    "clipboard-manager:allow-write-text",
    "log:allow-log",
    "allow-list-projects",
    "allow-create-project",
    "allow-update-project",
    "allow-archive-project",
    "allow-delete-project",
    "allow-list-todos",
    "allow-get-todo",
    "allow-create-todo",
    "allow-update-todo",
    "allow-change-status",
    "allow-delete-todo",
    "allow-set-todo-parent",
    "allow-set-todo-repeat",
    "allow-list-todo-templates",
    "allow-save-todo-template",
    "allow-rename-todo-template",
    "allow-delete-todo-template",
    "allow-add-dependency",
    "allow-remove-dependency",
    "allow-list-dependencies",
    "allow-preview-dependent-shift",
    "allow-shift-with-dependents",
    "allow-preview-bulk-change",
    "allow-apply-bulk-change",
    "allow-list-timeline",
    "allow-save-work-log",
    "allow-delete-work-log",
    "allow-get-settings",
    "allow-update-settings",
    "allow-get-dashboard",
    "allow-get-startup-reminder",
    "allow-ack-reminder",
    "allow-get-gantt",
    "allow-generate-report",
    "allow-save-report",
    "allow-get-report",
    "allow-export-report-file",
    "allow-list-backups",
    "allow-restore-backup",
    "allow-open-data-folder",
    "allow-choose-backup-mirror",
    "allow-clear-backup-mirror",
    "allow-restore-backup-file",
    "allow-test-notification",
    "allow-list-holidays",
    "allow-search-todos",
    "allow-export-data",
    "allow-import-data"
  ]
}
