{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window: Tauri core defaults, the app's own commands, opening http(s) links in the default browser, and writing text to the clipboard.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://*"
        },
        {
          "url": "http://*"
        }
      ]
    },
    "clipboard-manager:allow-write-text",
    "allow-list-projects",
    "allow-create-project",
    "allow-update-project",
    "allow-archive-project",
    "allow-delete-project",
    "allow-list-todos",
    "allow-get-todo",
    "allow-create-todo",
    "allow-update-todo",
    "allow-change-status",
    "allow-delete-todo",
    "allow-list-timeline",
    "allow-save-work-log",
    "allow-delete-work-log",
    "allow-get-settings",
    "allow-update-settings",
    "allow-get-dashboard",
    "allow-get-startup-reminder",
    "allow-ack-reminder",
    "allow-get-gantt",
    "allow-generate-report",
    "allow-save-report",
    "allow-get-report",
    "allow-export-report-file"
  ]
}
